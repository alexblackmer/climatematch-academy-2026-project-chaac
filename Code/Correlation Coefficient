 coordinate.\n","\n","  Returns a pandas DataFrame with the annual 'spi' and its 'category'\n","  \"\"\"\n","  spi_12m_annual = spi_data_array.resample(time='1YE').last()\n","  spi_12m_annual_pd = spi_12m_annual.to_pandas()\n","  spi_12m_annual_pd.index = spi_12m_annual_pd.index.year\n","  spi_12m_annual_pd.index.name = 'year'\n","  spi_values = spi_12m_annual_pd.rename('SPI Value')\n","\n","  # Define bins and labels for drought severity\n","  bins = [-np.inf, -2.0, -1.5, -1.0, 0, np.inf]\n","  labels = ['Extreme Drought', 'Severe Drought', 'Moderate Drought', 'Mild Drought', 'No Drought']\n","\n","  # Categorize SPI values\n","  spi_category = pd.cut(spi_values, bins=bins, labels=labels, right=False)\n","\n","  # Create a DataFrame from the results\n","  result_df = pd.DataFrame({\n","      'spi': spi_values,\n","      'category': spi_category\n","  })\n","\n","  return result_df"],"metadata":{"id":"XxmGyZKZNZbx","executionInfo":{"status":"ok","timestamp":1784916043226,"user_tz":420,"elapsed":4,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":142,"outputs":[]},{"cell_type":"code","source":["per_year_months_at_severity_level_viet = monthly_severity_per_year(spi_1m_viet)"],"metadata":{"id":"m0Uo1qj_Nie0","executionInfo":{"status":"ok","timestamp":1784916043626,"user_tz":420,"elapsed":2,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":143,"outputs":[]},{"cell_type":"code","source":["per_year_months_at_severity_level_indonesia = monthly_severity_per_year(spi_1m_ind)"],"metadata":{"id":"U4OWubsmNjAI","executionInfo":{"status":"ok","timestamp":1784916044046,"user_tz":420,"elapsed":45,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":144,"outputs":[]},{"cell_type":"code","source":["spi_yearly_viet = categorize_spi(spi_12m_viet)\n","spi_yearly_indonesia = categorize_spi(spi_12m_ind)"],"metadata":{"id":"2HcCq96pNmOS","executionInfo":{"status":"ok"