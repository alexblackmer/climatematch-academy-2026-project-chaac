able has a non-conforming standard_name: Got `convective precipitation rate`, expected `['precipitation_flux']`\n","  check_valid(vardata, \"standard_name\", data[\"standard_name\"])\n","/usr/local/lib/python3.12/dist-packages/xclim/core/cfchecks.py:77: UserWarning: Variable does not have a `cell_methods` attribute.\n","  _check_cell_methods(getattr(vardata, \"cell_methods\", None), data[\"cell_methods\"])\n","/usr/local/lib/python3.12/dist-packages/xclim/core/cfchecks.py:79: UserWarning: Variable has a non-conforming standard_name: Got `convective precipitation rate`, expected `['precipitation_flux']`\n","  check_valid(vardata, \"standard_name\", data[\"standard_name\"])\n"]}]},{"cell_type":"code","source":["### Annual SPI Metrics"],"metadata":{"id":"qxpelE8fPG0g","executionInfo":{"status":"ok","timestamp":1784764242475,"user_tz":420,"elapsed":10,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":94,"outputs":[]},{"cell_type":"code","source":["def monthly_severity_per_year(x):\n","  '''takes x, an xarray.DataArray with variable 'spi' monthly and outputs a pandas dataframe of the number of months at each severity level per year'''\n","  yearly = x.groupby('time.year').map(lambda x: x.groupby_bins(x, bins=[-np.inf, -2, -1.5, -1, 0, np.inf]).count()).fillna(0)\n","  yearly = yearly.to_dataframe().pivot_table(index = 'year', columns = 'spi_bins')\n","  yearly.columns = yearly.columns.droplevel(0)\n","  new_column_names = ['Extreme', 'Severe', 'Moderate', 'Mild', 'No Drought']\n","  yearly.columns = new_column_names\n","  return yearly\n"],"metadata":{"id":"q81VWSEGGQr7","executionInfo":{"status":"ok","timestamp":1784764242486,"user_tz":420,"elapsed":3,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":95,"outputs":[]},{"cell_type":"code","source":["per_year_months_at_severity_level_viet = monthly_severity_per_year(spi_1m_viet)"],"metadata":{"id":"7A-PBbkBGhmg","executionInfo":{"status":"ok","timestamp":1784764242865,"user_tz":420,"elapsed":378,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":96,"outputs":[]},{"cell_type":"code","source":["per_year_months_at_severity_level_indonesia = monthly_severity_per_year(spi_1m_indonesia)"],"metadata":{"id":"dyYmn4L9HMz1","executionInfo":{"status":"ok","timestamp":1784764243142,"user_tz":420,"elapsed":276,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"execution_count":97,"outputs":[]},{"cell_type":"code","metadata":{"id":"13993606","executionInfo":{"status":"ok","timestamp":1784764243156,"user_tz":420,"elapsed":1,"user":{"displayName":"Caroline Roper","userId":"15479337415278917690"}}},"source":["def categorize_spi(spi_data_array):\n","  \"\"\"\n","  Categorizes SPI values into drought severity levels.\n","\n","  Takes an xarray DataArray containing 12m SPI values with a 'time' coordinate.\n","\n","  Returns a pandas DataFrame with the annual 'spi' and its 'category'\n","  \"\"\"\n","  spi_12m_annual = spi_data_array.resample(time='1YE').last()\n","  spi_12m_annual_pd = spi_12m_annual.to_pandas()\n","  spi_12m_annual_pd.index = spi_12m_annual_pd.index.year\n","  spi_12m_annual_pd.index.name = 'year'\n","  spi_values = spi_12m_annual_pd.rename('SPI Value')\n","\n","  # Define bins and labels for drought severity\n","  bins = [-np.inf, -2.0, -1.5, -1.0, 0, np.inf]\n","  labels = ['Extreme Drought', 'Severe Drought', 'Moderate Drought', 'Mild Drought', 'No Drought']\n","\n","  # Categorize SPI values\n","  spi_category = pd.cut(spi_values, bins=bins, labels=labels, right=False)\n","\n","  # Create a DataFrame from the results\n","  result_df = pd.DataFrame({\n","      'spi': spi_values,\n","      'category': spi_category\n","  })\n","\n","  return result_df"],"execution_count":98,"outputs":[]},{"cell_type":"code","source":["spi_yearly_viet = categorize_spi(spi_12m_viet)\n","spi_yearly_indonesia = categorize_spi(spi_12m_indonesia)"],"metadata":{